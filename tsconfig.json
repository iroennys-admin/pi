{
        "extends": "./tsconfig.base.json",
        "compilerOptions": {
                "noEmit": true,
                "paths": {
                        "*": ["./*"],
                        "@iroennys/iropi-ai": ["./packages/ai/src/index.ts"],
                        "@iroennys/iropi-ai/oauth": ["./packages/ai/src/oauth.ts"],
                        "@iroennys/iropi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
                        "@iroennys/iropi-ai/dist/*": ["./packages/ai/src/*"],
                        "@iroennys/iropi-agent-core": ["./packages/agent/src/index.ts"],
                        "@iroennys/iropi-agent-core/*": ["./packages/agent/src/*"],
                        "@iroennys/iropi-coding-agent": ["./packages/coding-agent/src/index.ts"],
                        "@iroennys/iropi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
                        "@iroennys/iropi-coding-agent/*": ["./packages/coding-agent/src/*"],
                        "typebox": ["./node_modules/typebox"],
                        "@iroennys/iropi-tui": ["./packages/tui/src/index.ts"],
                        "@iroennys/iropi-tui/*": ["./packages/tui/src/*"]
                }
        },
        "include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
        "exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
